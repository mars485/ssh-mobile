    <string name="settings_about_section">About</string>
    <string name="settings_about_version">SSH Mobile %1$s</string>
    <string name="settings_about_text">A native Android SSH client built with Kotlin, Jetpack Compose and SSHJ. Secrets are encrypted with the Android Keystore; host keys are verified on every connection and changes require explicit confirmation.</string>
    <string name="settings_about_licenses">Terminal emulator: VT100/xterm implementation included in this project (no GPL terminal code). SSH transport: SSHJ 0.41 (Apache-2.0).</string>
    <string name="settings_wipe_dialog_title">Wipe all app data?</string>
    <string name="settings_wipe_dialog_message">Every saved server, credential and trusted host key will be deleted. This cannot be undone and open sessions may stop working.</string>
    <string name="settings_wipe_confirm">Wipe everything</string>
    <string name="settings_wiped">All local data wiped</string>
    <string name="settings_security_note">Remember: automatic reconnect never bypasses host-key verification.</string>

