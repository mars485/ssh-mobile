---
import Icon from './Icon.astro';
import { site, type Dict } from '../i18n/content';

interface Props {
  t: Dict;
}

const { t } = Astro.props;

const heroShot = t.screenshots.items.find((s) => s.id === 'htop') ?? t.screenshots.items[0];
---

<section class="relative isolate overflow-hidden" aria-labelledby="hero-title">
  <div class="pointer-events-none absolute inset-0 -z-10 card-grid-bg opacity-60"></div>
  <div
    class="pointer-events-none absolute -top-52 left-1/2 -z-10 h-[520px] w-[880px] -translate-x-1/2 glow-accent blur-3xl"
  >
  </div>

  <div
    class="container-itg relative grid gap-12 pb-14 pt-8 sm:pt-12 lg:grid-cols-[1.02fr_0.98fr] lg:items-center lg:gap-8 lg:pb-24 lg:pt-16"
  >
    <div class="max-w-[560px]">
      <p class="kicker flex items-center gap-2 text-[10px] sm:text-[11px]">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent"></span>
        {t.hero.eyebrow}
      </p>

      <h1
        id="hero-title"
        class="mt-5 text-[2.55rem] font-semibold leading-[0.94] tracking-[-0.035em] sm:text-[3.8rem] lg:text-[4.4rem]"
      >
        SSH <span class="text-muted">Mobile</span>
      </h1>

      <p class="mt-4 text-[1.3rem] font-medium leading-[1.25] tracking-[-0.01em] sm:text-[1.6rem]">
        {t.hero.tagline}
      </p>

      <p class="mt-4 max-w-[500px] text-[15px] leading-relaxed text-muted sm:text-[16px]">
        {t.hero.lead}
      </p>

      <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href={site.rustore}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary w-full sm:w-auto"
        >
          <Icon name="download" size={18} />
          {t.hero.primary}
        </a>
        <a
          href={site.repo}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-ghost w-full sm:w-auto"
        >
          <Icon name="github" size={18} />
          {t.hero.secondary}
        </a>
      </div>

      <p class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-[11px] text-dim">
        <span class="uppercase tracking-[0.16em] text-term/80">{t.hero.statusLabel}</span>
        <span class="text-line-strong">/</span>
        <span>{t.hero.status}</span>
      </p>

      <dl class="mt-8 grid max-w-[420px] grid-cols-3 divide-x divide-line border-y border-line">
        {
          t.hero.stats.map((s) => (
            <div class="min-w-0 px-2.5 py-4 first:pl-0 sm:px-3">
              <dt class="sr-only">{s.label}</dt>
              <dd class="whitespace-nowrap font-mono text-[15px] font-semibold tracking-tight text-ink sm:text-[17px]">{s.value}</dd>
              <dd class="mt-1 text-[9.5px] uppercase tracking-[0.1em] text-dim sm:text-[11px] sm:tracking-[0.12em]">{s.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="relative mx-auto w-full max-w-[420px] lg:max-w-none">
      <div class="relative z-0 mx-auto w-[74%] max-w-[320px] lg:ml-auto lg:mr-4">
        <div class="phone-frame">
          <img
            src="/shots/hero-720.webp"
            srcset="/shots/hero-480.webp 480w, /shots/hero-720.webp 720w, /shots/hero-1080.webp 1080w"
            sizes="(min-width: 1024px) 320px, 70vw"
            width="720"
            height="1400"
            alt={heroShot.alt}
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <span
          class="absolute -right-3 top-6 rounded-md border border-line bg-panel px-2 py-1 font-mono text-[10px] uppercase tracking-[0.12em] text-muted lg:-right-8"
        >
          v{site.versionPending}
        </span>
      </div>

      <div
        class="relative z-10 mt-8 w-full rounded-xl border border-line bg-black/85 p-0 shadow-[0_24px_60px_-30px_rgba(0,0,0,.95)] backdrop-blur lg:absolute lg:-left-6 lg:bottom-2 lg:mt-0 lg:w-[330px] xl:-left-12"
      >
        <div class="flex items-center gap-2 border-b border-line/80 px-3 py-2">
          <span class="flex gap-1.5">
            <span class="h-2 w-2 rounded-full bg-accent/70"></span>
            <span class="h-2 w-2 rounded-full bg-line-strong"></span>
            <span class="h-2 w-2 rounded-full bg-line-strong"></span>
          </span>
          <span class="ml-1 truncate font-mono text-[10px] text-dim">{t.hero.terminalTitle}</span>
        </div>
        <div class="space-y-1 overflow-hidden px-3 py-3 font-mono text-[11px] leading-relaxed">
          <p class="truncate whitespace-nowrap text-term/70">{t.hero.terminalLines[0]}</p>
          <p class="truncate whitespace-nowrap text-dim">{t.hero.terminalLines[1]}</p>
          <p class="truncate whitespace-nowrap text-ink/90">{t.hero.terminalLines[2]}</p>
          <p class="truncate whitespace-nowrap text-ink/90">
            {t.hero.terminalLines[3]}<span class="ml-1 inline-block h-3 w-1.5 translate-y-[1px] bg-term"></span>
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="container-itg">
    <div class="hairline"></div>
  </div>
</section>
