---
import Icon from './Icon.astro';
import { site, type Dict } from '../i18n/content';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
---

<section id="security" class="section-pad scroll-mt-24 border-y border-line bg-bg-soft/70" aria-labelledby="security-title">
  <div class="container-itg">
    <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
      <div>
        <p class="kicker">{t.security.kicker}</p>
        <h2 id="security-title" class="mt-4 text-[1.75rem] font-semibold leading-[1.12] tracking-[-0.02em] sm:text-[2.2rem] lg:text-[2.5rem]">
          {t.security.title}
        </h2>
        <p class="mt-4 max-w-[440px] text-[15px] leading-relaxed text-muted">{t.security.lead}</p>

        <div class="mt-7 relative overflow-hidden rounded-xl border border-line bg-black/60 p-4">
          <div class="pointer-events-none absolute -right-10 -top-10 h-32 w-32 rounded-full bg-accent/10 blur-2xl"></div>
          <div class="flex items-center gap-2 border-b border-line/70 pb-2 font-mono text-[10px] uppercase tracking-[0.14em] text-dim">
            <Icon name="lock" size={13} class="text-term/80" />
            keystore / credentials
          </div>
          <pre class="mt-3 overflow-x-auto font-mono text-[11px] leading-relaxed text-term/80"><code>{`cipher  AES/GCM/NoPadding
key     AndroidKeyStore (non-exportable)
store   Room · secrets sealed
backup  android:allowBackup="false"`}</code></pre>
        </div>

        <a
          href={site.security}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 inline-flex items-center gap-2 text-[13.5px] font-medium text-ink underline decoration-line-strong underline-offset-4 transition-colors hover:decoration-accent"
        >
          {t.security.link}
          <Icon name="external" size={14} class="text-dim" />
        </a>
      </div>

      <div>
        <ul class="grid gap-3 sm:grid-cols-2">
          {
            t.security.items.map((s) => (
              <li class="rounded-xl border border-line bg-panel/70 p-5">
                <div class="flex items-center justify-between gap-3">
                  <span class="grid h-9 w-9 place-items-center rounded-lg border border-line bg-black/50 text-accent">
                    <Icon name="shield" size={17} />
                  </span>
                  <span class="font-mono text-[9.5px] uppercase tracking-[0.12em] text-dim">{s.tag}</span>
                </div>
                <h3 class="mt-4 text-[15px] font-semibold tracking-[-0.01em]">{s.title}</h3>
                <p class="mt-2 text-[13px] leading-relaxed text-muted">{s.text}</p>
              </li>
            ))
          }
        </ul>

        <div class="mt-3 rounded-xl border border-line bg-panel/40 p-5">
          <h3 class="font-mono text-[10.5px] uppercase tracking-[0.16em] text-dim">
            {t.security.absenceTitle}
          </h3>
          <ul class="mt-3 grid gap-2 sm:grid-cols-2">
            {
              t.security.absence.map((a) => (
                <li class="flex items-start gap-2 text-[13px] text-muted">
                  <Icon name="close" size={13} class="mt-[3px] shrink-0 text-accent/80" />
                  <span>{a}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
