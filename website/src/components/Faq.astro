---
import Icon from './Icon.astro';
import { site, type Dict } from '../i18n/content';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
---

<section id="faq" class="section-pad scroll-mt-24" aria-labelledby="faq-title">
  <div class="container-itg grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:gap-14">
    <div>
      <p class="kicker">{t.faq.kicker}</p>
      <h2 id="faq-title" class="mt-4 text-[1.75rem] font-semibold leading-[1.12] tracking-[-0.02em] sm:text-[2.2rem] lg:text-[2.5rem]">
        {t.faq.title}
      </h2>
      <p class="mt-4 max-w-[400px] text-[15px] leading-relaxed text-muted">{t.faq.lead}</p>
      <a
        href={site.issues}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-5 inline-flex items-center gap-2 text-[13.5px] font-medium text-ink underline decoration-line-strong underline-offset-4 transition-colors hover:decoration-accent"
      >
        GitHub Issues
        <Icon name="external" size={14} class="text-dim" />
      </a>
    </div>

    <div class="divide-y divide-line border-y border-line">
      {
        t.faq.items.map((item) => (
          <details class="faq-item group py-4">
            <summary class="flex items-start justify-between gap-4 text-[15px] font-medium leading-snug text-ink">
              <span>{item.q}</span>
              <Icon name="plus" size={17} class="faq-plus mt-0.5 shrink-0 text-muted transition-transform duration-200" />
            </summary>
            <p class="mt-2.5 pr-6 text-[13.5px] leading-relaxed text-muted">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
