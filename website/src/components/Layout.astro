---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, type Dict, type Lang } from '../i18n/content';
import '../styles/global.css';

interface Props {
  t: Dict;
  lang: Lang;
  path?: string;
}

const { t, lang, path = lang === 'en' ? '/en/' : '/' } = Astro.props;

const altPath = lang === 'ru' ? '/en/' : '/';
const origin = Astro.site ?? new URL('https://ssh.itgsystem.ru');
const canonical = new URL(path, origin).href;
const ogImage = new URL('/og-cover.png', origin).href;

const softwareLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: 'SSH Mobile',
      applicationCategory: 'UtilitiesApplication',
      applicationSubCategory: 'SSH client',
      operatingSystem: 'Android 10+',
      softwareVersion: site.versionInStore,
      downloadUrl: site.rustore,
      installUrl: site.rustore,
      inLanguage: ['ru', 'en'],
      license: 'https://www.apache.org/licenses/LICENSE-2.0',
      isAccessibleForFree: true,
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'RUB',
      },
      description: t.seo.description,
      screenshot: [
        new URL('/shots/dashboard-720.webp', origin).href,
        new URL('/shots/terminal-720.webp', origin).href,
      ],
      featureList: t.features.items.map((f) => f.title),
      author: {
        '@type': 'Organization',
        name: 'IT GROUP',
        url: site.itg,
        email: site.email,
      },
      sameAs: [site.repo],
    },
    {
      '@type': 'FAQPage',
      mainEntity: t.faq.items.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    },
  ],
};
---

<!doctype html>
<html lang={lang === 'ru' ? 'ru' : 'en'} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.seo.title}</title>
    <meta name="description" content={t.seo.description} />
    <meta name="keywords" content={t.seo.keywords} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#08090b" />
    <meta name="author" content="IT GROUP" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ru" href={new URL('/', origin).href} />
    <link rel="alternate" hreflang="en" href={new URL('/en/', origin).href} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', origin).href} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SSH Mobile" />
    <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'ru' ? 'en_US' : 'ru_RU'} />
    <meta property="og:title" content={t.seo.ogTitle} />
    <meta property="og:description" content={t.seo.ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.seo.ogTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.seo.ogTitle} />
    <meta name="twitter:description" content={t.seo.ogDescription} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <script type="application/ld+json" set:html={JSON.stringify(softwareLd)} />

    {/* Баннер кампании Keep Android Open (третья сторона, GPL-3.0, self-contained).
        Хост разрешён в CSP nginx/security-headers.conf. */}
    <script
      is:inline
      defer
      src="https://keepandroidopen.org/banner.js?lang=ru&size=mini&id=my-banner"></script>
  </head>
  <body class="min-h-screen antialiased">
    <div id="my-banner" class="banner-slot"></div>

    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[80] focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:font-medium focus:text-black"
    >
      {t.nav.skip}
    </a>

    <Header t={t} lang={lang} altHref={altPath} altLabel={lang === 'ru' ? 'EN' : 'RU'} />

    <main id="main">
      <slot />
    </main>

    <Footer t={t} lang={lang} altHref={altPath} />

    <script is:inline>
      // Баннер вставляется третьим скриптом асинхронно: держим шапку и контент ниже него.
      (function () {
        var slot = document.getElementById('my-banner');
        if (!slot) return;
        var root = document.documentElement;
        var seenBanner = false;
        var gaveUp = false;
        var apply = function () {
          // Баннер закрывается через display:none, поэтому мерим видимых детей, а не детей вообще.
          var visible = 0;
          for (var i = 0; i < slot.childElementCount; i++) {
            var el = slot.children[i];
            if (getComputedStyle(el).display !== 'none') visible = Math.max(visible, el.getBoundingClientRect().height);
          }
          if (visible > 0) seenBanner = true;
          // Пока внешний скрипт не ответил, держим резерв из CSS, иначе шапка прыгает вверх (CLS).
          var collapsed = visible === 0 && (seenBanner || gaveUp);
          slot.classList.toggle('is-collapsed', collapsed);
          if (collapsed) root.style.setProperty('--banner-h', '0px');
          else if (visible > 0) root.style.setProperty('--banner-h', visible + 'px');
        };
        apply();
        if (window.ResizeObserver) new ResizeObserver(apply).observe(slot);
        if (window.MutationObserver) new MutationObserver(apply).observe(slot, { childList: true, subtree: true });
        window.addEventListener('load', apply);
        slot.addEventListener('click', function () { setTimeout(apply, 60); }, true);
        // если внешний скрипт не загрузился — не держим пустую полосу
        setTimeout(function () {
          if (!seenBanner) {
            gaveUp = true;
            apply();
          }
        }, 3000);
      })();
    </script>

    <script>
      const header = document.getElementById('site-header');
      const onScroll = () => {
        if (!header) return;
        header.dataset.scrolled = window.scrollY > 8 ? 'true' : 'false';
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      const menu = document.getElementById('mobile-menu');
      const openBtn = document.getElementById('menu-open');
      const closeBtn = document.getElementById('menu-close');
      const panel = menu?.querySelector('[role="dialog"]');

      function setMenu(open: boolean) {
        if (!menu || !openBtn) return;
        menu.hidden = !open;
        openBtn.setAttribute('aria-expanded', String(open));
        document.body.classList.toggle('is-locked', open);
        if (open) {
          (menu.querySelector('a, button') as HTMLElement | null)?.focus();
        } else {
          openBtn.focus();
        }
      }

      openBtn?.addEventListener('click', () => setMenu(true));
      closeBtn?.addEventListener('click', () => setMenu(false));
      menu?.querySelectorAll('[data-menu-close], [data-menu-link]').forEach((el) =>
        el.addEventListener('click', () => setMenu(false)),
      );

      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape' || !menu || menu.hidden) return;
        setMenu(false);
      });

      // Keep focus inside the panel while it is open.
      panel?.addEventListener('keydown', (e) => {
        const ev = e as KeyboardEvent;
        if (ev.key !== 'Tab' || !panel) return;
        const items = Array.from(
          panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'),
        ).filter((el) => el.offsetParent !== null);
        if (!items.length) return;
        const first = items[0];
        const last = items[items.length - 1];
        if (!ev.shiftKey && document.activeElement === last) {
          ev.preventDefault();
          first.focus();
        } else if (ev.shiftKey && document.activeElement === first) {
          ev.preventDefault();
          last.focus();
        }
      });
    </script>
  </body>
</html>
