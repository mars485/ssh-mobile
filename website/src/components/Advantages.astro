---
import Icon from './Icon.astro';
import { site, type Dict } from '../i18n/content';

interface Props {
  t: Dict;
}

const { t } = Astro.props;

const stack = [
  { k: 'language', v: 'Kotlin 2.1' },
  { k: 'ui', v: 'Jetpack Compose' },
  { k: 'ssh client', v: 'SSHJ' },
  { k: 'storage', v: 'Room + Keystore' },
  { k: 'minSdk', v: `29 / Android ${site.androidMin}+` },
  { k: 'license', v: site.license },
];
---

<section id="advantages" class="section-pad scroll-mt-24" aria-labelledby="advantages-title">
  <div class="container-itg grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
    <div class="lg:sticky lg:top-24 lg:self-start">
      <p class="kicker">{t.advantages.kicker}</p>
      <h2 id="advantages-title" class="mt-4 text-[1.75rem] font-semibold leading-[1.12] tracking-[-0.02em] sm:text-[2.2rem] lg:text-[2.5rem]">
        {t.advantages.title}
      </h2>
      <p class="mt-4 max-w-[420px] text-[15px] leading-relaxed text-muted">{t.advantages.lead}</p>

      <dl class="mt-8 overflow-hidden rounded-xl border border-line bg-panel/60">
        {
          stack.map((s) => (
            <div class="flex items-baseline justify-between gap-4 border-b border-line/70 px-4 py-2.5 last:border-b-0">
              <dt class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-dim">{s.k}</dt>
              <dd class="text-right font-mono text-[11.5px] text-ink/85">{s.v}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <ul class="grid gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2">
      {
        t.advantages.items.map((item, i) => (
          <li class="flex flex-col bg-bg p-6">
            <span class="font-mono text-[11px] tracking-[0.16em] text-accent">
              0{i + 1}
            </span>
            <h3 class="mt-3 text-[17px] font-semibold tracking-[-0.01em]">{item.title}</h3>
            <p class="mt-2 text-[13.5px] leading-relaxed text-muted">{item.text}</p>
          </li>
        ))
      }
      <li class="flex flex-col justify-between gap-4 bg-bg p-6 sm:col-span-2">
        <div class="flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.14em] text-dim">
          <Icon name="terminal" size={15} class="text-term/70" />
          <span>open source</span>
        </div>
        <p class="text-[13.5px] leading-relaxed text-muted">
          {site.license} · {site.packageId}
        </p>
        <a
          href={site.repo}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex w-fit items-center gap-2 text-[13px] font-medium text-ink underline decoration-line-strong decoration-1 underline-offset-4 transition-colors hover:decoration-accent"
        >
          github.com/mars485/ssh-mobile
          <Icon name="external" size={14} class="text-dim" />
        </a>
      </li>
    </ul>
  </div>
</section>
