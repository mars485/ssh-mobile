---
import { site } from '../i18n/content';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>404 — SSH Mobile</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style>
      :root { color-scheme: dark; }
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: #08090b;
        color: #f3f5f7;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
        text-align: center;
        padding: 24px;
      }
      .mono { font-family: ui-monospace, "SFMono-Regular", Menlo, monospace; }
      a { color: #ff3b2f; text-decoration: none; }
      a:hover { text-decoration: underline; }
      .code { font-size: 13px; color: #99a3b0; letter-spacing: 0.16em; text-transform: uppercase; }
      h1 { font-size: clamp(2rem, 8vw, 3.4rem); margin: 12px 0 8px; letter-spacing: -0.03em; }
      p { color: #99a3b0; margin: 0 0 24px; }
    </style>
  </head>
  <body>
    <main>
      <p class="code mono">404 · not found</p>
      <h1>Страница не найдена</h1>
      <p>Такого адреса нет. Вернитесь на главную или откройте репозиторий.</p>
      <p class="mono" style="font-size:14px">
        <a href="/">ssh.itgsystem.ru</a> ·
        <a href={site.repo}>github.com/mars485/ssh-mobile</a>
      </p>
    </main>
  </body>
</html>
